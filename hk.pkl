amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

local all = (generated.steps) {
  ...generated.push
  // nix T55: the crate packages, and the packaged crate alone builds; a
  // file the build embeds but the package leaves out (src/script/*.sh)
  // fails here, not at publish. As pklith T42. Push only: it builds the
  // crate again from the tarball.
  ["package"] {
    glob = List("Cargo.toml", "Cargo.lock", "src/**")
    check = "cargo package --locked --allow-dirty -q -p actlith"
  }
  // nix T56: no dependency with a published advisory. It fetches the
  // advisory database, so it runs at push, which needs the network anyway;
  // the commit-time `deny` step stays offline. As pklith T40.
  ["deny-advisories"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "cargo deny check advisories"
  }
  // nix T58: the vendored schema is the one the pinned hk ships, and
  // pkl/VENDORED.md names its version and sha256. As pklith V28. Push
  // only: it evaluates the flake and realises hk's source.
  ["schema-pin"] {
    glob = List("pkl/**", "flake.lock", "nix/guard/schema-pin.sh")
    check = "bash nix/guard/schema-pin.sh"
  }
  // nix T32: the flake's actlith built by nix and run as built on a
  // fixture repository (as pklith T62). Push only: a nix build.
  ["package-nix"] {
    glob = List("flake.nix", "flake.lock", "Cargo.toml", "Cargo.lock", "src/**", "dev/**", "nix/guard/package-nix.sh")
    check = "bash nix/guard/package-nix.sh"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    // "none", not "git": the git stash is shared by every worktree, so with
    // parallel wave workers one hook popped another checkout's files
    // (nix:B5). hk 2.7.0 keeps patch files in the git dir (jdx/hk#1705), so
    // "patch-file" would now be safe; "none" stays until that is measured.
    stash = "none"
    // `test` is in the push set (category coverage in .pklith), not here: a
    // RED commit must land with failing tests (TDD), as in congestimancer.
    steps = (generated.steps) {
      // nix T12 (V19): commits land through a branch and pull request,
      // never directly on main. HERE, not in `all`: it is a rule about
      // making a commit, which happens only on a development machine,
      // through this hook. pre-push, `hk check`, CI and the release hook
      // all run on main by design, so there the step could only fail. As
      // pklith T19.
      ["no-commit-to-branch"] {
        check = "hk util no-commit-to-branch --branch main"
      }
    }
  }
  // T5: subject `type(scope): claim`, at most 72 characters, a body that
  // says why. hk passes the file git gave the hook (MERGE_MSG on a merge).
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "cargo run -q -p actlith-dev -- commit-msg {{commit_msg_file}}"
      }
      // T4, V18: a feat, fix or perf commit changing src/ adds a CHANGELOG
      // entry. Here, not in pre-commit: only the message says which kind a
      // change is.
      ["changelog-touched"] {
        check = "cargo run -q -p actlith-dev -- changelog {{commit_msg_file}}"
        // After commit-msg, never beside it: two cargo runs at once contend
        // for the target directory lock.
        depends = List("commit-msg")
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    // hk 2.x stages fixes only in pre-commit unless a hook asks for it.
    stage = true
    steps = all
  }
}
